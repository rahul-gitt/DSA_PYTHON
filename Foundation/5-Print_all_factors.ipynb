   "source": [
    "Brut Force Solution:"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "6edd95f1",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "The Factor's are [1, 5, 25].\n"
     ]
    }
   ],
   "source": [
    "n = int(input(\"Enter a  number : \"))\n",
    "num = n\n",
    "result = []\n",
    "\n",
    "for i in range(1, num+1):\n",
    "    if num% i == 0:\n",
    "        result.append(i)\n",
    "\n",
    "print(f\"The Factor's are {result}.\")"
   ]
  }
 ],
