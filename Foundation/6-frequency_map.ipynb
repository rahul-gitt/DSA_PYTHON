   "source": [
    "n = list(map(int, input(\"Enter Elements : \").split()))\n",
    "\n",
    "freq_map = {}\n",
    "\n",
    "for i in range(0, len(n)):\n",
    "    if n[i] in freq_map:\n",
    "        freq_map[n[i]]+= 1\n",
    "    else:\n",
    "        freq_map[n[i]] = 1\n",
    "\n",
    "print(f\"Number Frequency is {freq_map}\")"
   ]
